{
  "name": "commonsong",
  "version": "0.1.0",
  "description": "Provider-agnostic AI song generation engines (Mureka + ElevenLabs Music) with verbatim-lyrics discipline. Shared across the yabroexperiments portfolio.",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types scripts/test-eleven-offline.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "music",
    "song-generation",
    "mureka",
    "elevenlabs",
    "karaoke",
    "taiwan"
  ],
  "author": "yabroexperiments",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yabroexperiments/commonsong.git"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.6.0"
  }
}
